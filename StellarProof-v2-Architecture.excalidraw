    },
    {
      "id": "text-issuer-detail",
      "type": "text",
      "x": 675,
      "y": 285,
      "width": 650,
      "height": 310,
      "angle": 0,
      "strokeColor": "#94a3b8",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 80,
      "seed": 802,
      "version": 1,
      "versionNonce": 802,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Webhook Handler (/webhook/didit)\n────────────────────────────────\n• HMAC-SHA256 verification (X-Signature-V2)\n• Canonical JSON, constant-time comparison\n• 300s timestamp window, event_id idempotency\n\nCredential Issuance Pipeline\n────────────────────────────────\n1. Read 3 attrs IN MEMORY ONLY:\n   DOB → dobDays | Expiry → docExpiryDays | Country → countryCode\n2. Build Poseidon commitment\n   Poseidon(dob, expiry, country, secretHash, salt, revNonce)\n3. Sign with EdDSA-BabyJubjub (issuer key)\n4. Seal with XChaCha20-Poly1305 → holder's X25519 key\n5. Store ONLY ciphertext, DISCARD attributes\n\n⚠ no-pii.test.mjs enforces this mechanically",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Webhook Handler (/webhook/didit)\n────────────────────────────────\n• HMAC-SHA256 verification (X-Signature-V2)\n• Canonical JSON, constant-time comparison\n• 300s timestamp window, event_id idempotency\n\nCredential Issuance Pipeline\n────────────────────────────────\n1. Read 3 attrs IN MEMORY ONLY:\n   DOB → dobDays | Expiry → docExpiryDays | Country → countryCode\n2. Build Poseidon commitment\n   Poseidon(dob, expiry, country, secretHash, salt, revNonce)\n3. Sign with EdDSA-BabyJubjub (issuer key)\n4. Seal with XChaCha20-Poly1305 → holder's X25519 key\n5. Store ONLY ciphertext, DISCARD attributes\n\n⚠ no-pii.test.mjs enforces this mechanically",
      "autoResize": true,
      "lineHeight": 1.25
    },
