      "versionNonce": 3100,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "⚠ PII crosses exactly ONE edge:\nDidit → Issuer, in memory, once.\nEverything downstream is commitments,\nciphertext and proofs.",
