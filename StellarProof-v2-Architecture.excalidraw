    {
      "id": "crypto-callout",
      "type": "text",
      "x": 60,
      "y": 1180,
      "width": 490,
      "height": 130,
      "angle": 0,
      "strokeColor": "#10B981",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 70,
      "seed": 3200,
      "version": 1,
      "versionNonce": 3200,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Crypto Stack:\n• Groth16 over BN254 (20,998 constraints, 8 pub inputs)\n• Poseidon hash (commitment + nullifier)\n• EdDSA-BabyJubjub (credential signing)\n• XChaCha20-Poly1305 (sealed delivery)\n• SMT non-membership (revocation)\n• HKDF-SHA256 (key derivation)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Crypto Stack:\n• Groth16 over BN254 (20,998 constraints, 8 pub inputs)\n• Poseidon hash (commitment + nullifier)\n• EdDSA-BabyJubjub (credential signing)\n• XChaCha20-Poly1305 (sealed delivery)\n• SMT non-membership (revocation)\n• HKDF-SHA256 (key derivation)",
      "autoResize": true,
      "lineHeight": 1.25
    }
