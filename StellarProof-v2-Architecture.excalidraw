      "versionNonce": 1501,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "⑤ ZK Verifier Contract",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
